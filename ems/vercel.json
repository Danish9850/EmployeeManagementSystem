{
    "builds":[
        {
            "src":"EmployeeManagementSystem/wsgi.py",
            "use":"@vercel/python"
        }
    ],
    "routes":[
        {
            "src":"/static/(.*)",
            "dest":"/static/$1"
        },
        {
            "src":"(.*)",
            "dest":"EmployeeManagementSystem/wsgi.py"
        }
    ]
}